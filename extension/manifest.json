{
  "manifest_version": 3,
  "name": "长截图 · 全屏 / 区域二合一",
  "version": "2.7.0",
  "description": "长截图：支持从指定位置开始截、自动复制到剪贴板、内置编辑器（裁剪/标注/导出）。",
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "长截图（全屏 / 区域）",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}